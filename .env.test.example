# Ambiente de TESTE — copie para `.env.test` (gitignored) antes de rodar a suíte.
#
# Este arquivo é montado SOBRE /app/.env dentro do container de teste. Como
# includes/env.php faz putenv() dos valores do arquivo (o arquivo vence o
# ambiente real), é ele que define a qual banco o app se conecta durante os
# testes. NUNCA aponte para produção.
#
#   cp .env.test.example .env.test

APP_NAME="Novix Fin (teste)"
APP_URL="http://localhost"
APP_TIMEZONE="America/Sao_Paulo"
APP_ENV=local

DB_HOST=db
DB_PORT=3306
DB_DATABASE=novixfin_test
DB_USERNAME=root
DB_PASSWORD=troque-por-sua-senha-de-teste
DB_CHARSET=utf8mb4

SESSION_NAME=novix_fin_session
SESSION_COOKIE_LIFETIME=604800
SESSION_COOKIE_SAMESITE=Lax
