# NovixFin v3 environment template.
# Copy this file to ".env" at the project root and fill in real values.
# NEVER commit the real .env file.

# ---- Application ----
APP_NAME="Novix Fin"
APP_URL="http://localhost/novix-fin/public"
APP_TIMEZONE="America/Sao_Paulo"
# local | production | prod
# local     => display_errors=1 (dev visibility)
# production => display_errors=0, log_errors=1 (never leak to response)
APP_ENV=production

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novix_fin
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- Session / Auth ----
# Keep SESSION_NAME stable across deployments: changing it invalidates
# existing sessions (users get logged out). Default = novix_fin_session
# (matches the v2 hardcoded value for backward compatibility).
SESSION_NAME=novix_fin_session
SESSION_COOKIE_LIFETIME=604800
SESSION_COOKIE_SAMESITE=Lax